# ARGUS API server — local environment template.
#
# Copy to `.env` and fill in real values. `.env` is git-ignored; never commit a
# real key.

# ARGUS Access Key for this phase.
#
# Required to activate ARGUS. The value is validated on the server only and is
# never returned by the API, logged, or written to browser storage.
ARGUS_DEV_ACCESS_KEY=ARGUS-DEV-2026
