# ARGUS API server — local environment template.
#
# Copy to `.env` and fill in real values. `.env` is git-ignored; never commit a
# real key.

# ARGUS Access Key for this phase.
#
# Required to activate ARGUS. The value is validated on the server only and is
# never returned by the API, logged, or written to browser storage.
ARGUS_DEV_ACCESS_KEY=ARGUS-DEV-2026
Port=5000
ARGUS_DATA_DIR=DATA

# Cross-origin allowlist for split deployments (Vercel frontend + Render API).
# Comma-separated list of exact origins allowed to call the API with cookies.
# Leave unset in local dev / single-origin deployments (any origin accepted).
# ARGUS_ALLOWED_ORIGINS=https://argus.vercel.app,https://argus-git-main-you.vercel.app

# Optional override for the desktop installer download target when neither a
# bundled exe nor a static asset exists (defaults to the GitHub release asset).
# ARGUS_INSTALLER_URL=https://github.com/subahanpathan/ARGUS/releases/latest/download/ARGUS-Setup.exe